# Copy this file to prod.env and replace every placeholder.
# prod.env is ignored by Git. Do not commit subscription IDs or recipient addresses.

# Optional: omit this line to use the Azure CLI's current subscription.
AZURE_SUBSCRIPTION_ID=

# Required: comma-separated recipients for production job-status email.
PLX_PARAM_ALERT_RECIPIENTS=

# Optional: required only when deployRoleAssignments is enabled for a fresh environment.
# PLX_CAMPAIGN_DEPLOY_PRINCIPAL_ID=
